@model List<catalogo_jogos.Models.Jogo>
@inject System.Text.Encodings.Web.JavaScriptEncoder jsEncoder

@{
    ViewData["Title"] = "Registros Salvos";
    var distinctYears = ViewData["DistinctYears"] as List<int> ?? new List<int>();
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentYearFilter = ViewData["CurrentYearFilter"] as int?;
    var currentUnicos = ViewData["CurrentUnicos"] as bool?;
    var currentNaoZeradosFilter = ViewData["CurrentNaoZeradosFilter"] as bool?;
    var currentPlatinadosFilter = ViewData["CurrentPlatinadosFilter"] as bool?;
}

<style>
    html, body {
        max-width: 100%;
        overflow-x: hidden;
        background-color: #121212;
        color: #e0e0e0;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .table-container {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #2d2d2d;
        box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    .table-custom {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        color: #fff;
        background-color: #1e1e1e;
        margin-bottom: 0;
    }

        .table-custom thead th {
            background-color: #252525;
            border-bottom: 2px solid #383838;
            font-size: 0.85rem;
            padding: 12px 4px;
            text-align: center;
            color: #a0a0a0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            background-color: #1e1e1e;
            border: 1px solid #2a2a2a;
            padding: 8px 4px;
            font-size: 0.9rem;
            text-align: center;
            vertical-align: middle;
        }

        .table-custom tbody tr:hover td {
            background-color: #262626;
        }

    .img-capa {
        width: 45px;
        height: 62px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #3d3d3d;
        background-color: #141414;
        transition: transform 0.2s ease;
    }

    .col-id {
        width: 40px;
    }

    .col-capa {
        width: 55px;
    }

    .col-nome {
        width: 22%;
        text-align: left !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .col-fix {
        width: 85px;
    }

    .col-acoes {
        width: 200px;
    }

    .form-control-sm {
        background-color: #2a2a2a !important;
        border: 1px solid #3d3d3d !important;
        color: #fff !important;
    }

    .btn-action-group .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
        font-weight: 500;
    }
</style>

<div class="container-fluid mt-4 px-4">
    <h3 class="mb-4 text-center text-white fw-bold">@ViewData["Title"]</h3>

    @* Busca *@
    <div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <form method="get" asp-action="ListaJogos" class="d-flex align-items-center flex-wrap">
            <label class="me-2 text-white fw-semibold">Buscar:</label>
            <input type="text" name="termoBusca" class="form-control form-control-sm me-2 mb-2" style="width: 200px;" value="@currentFilter" placeholder="Pesquisar..." />
            <input type="hidden" name="unicos" value="@(currentUnicos == true ? "true" : "")" />
            <input type="hidden" name="filtroAno" value="@currentYearFilter" />
            <button type="submit" class="btn btn-primary btn-sm me-2 mb-2 px-3">Buscar</button>
            <a asp-action="Estatisticas" class="btn btn-info btn-sm text-dark me-2 mb-2 px-3 fw-semibold">Ver Estatísticas</a>
            <a asp-action="ListaJogos" class="btn btn-outline-secondary btn-sm me-2 mb-2">Resetar</a>
        </form>

        <button type="submit" class="btn btn-success btn-sm mb-2 px-3 fw-semibold" form="formSalvarOrdem">Salvar Ordem</button>
    </div>

    <hr class="border-secondary opacity-25" />

    @* Filtros Superiores *@
    <div class="mb-3">
        <strong class="text-white me-2">Ordenar:</strong>
        <a asp-action="ListaJogos" asp-route-sortOrder="name" asp-route-termoBusca="@currentFilter" asp-route-filtroAno="@currentYearFilter" class="btn btn-sm btn-outline-light me-3">A-Z</a>
        <span class="text-white me-2"><strong>Anos:</strong></span>
        @foreach (var year in distinctYears)
        {
            <a asp-action="ListaJogos" asp-route-filtroAno="@(year == currentYearFilter ? null : year)" asp-route-termoBusca="@currentFilter" asp-route-unicos="@currentUnicos" class="btn btn-sm @(year == currentYearFilter ? "btn-primary" : "btn-outline-secondary text-white") me-1 mb-1">@year</a>
        }
    </div>

    @* Outros Filtros *@
    <div class="mb-4">
        <strong class="text-white me-2">Outros Filtros:</strong>
        <a asp-action="ListaJogos" asp-route-unicos="@(currentUnicos == true ? null : true)" asp-route-termoBusca="@currentFilter" asp-route-filtroAno="@currentYearFilter" class="btn btn-sm @(currentUnicos == true ? "btn-primary" : "btn-outline-secondary text-white") me-1">Únicos</a>

        <a asp-action="ListaJogos" asp-route-filtroNaoZerados="@(currentNaoZeradosFilter == true ? null : true)" asp-route-termoBusca="@currentFilter" asp-route-filtroAno="@currentYearFilter" asp-route-unicos="@currentUnicos" class="btn btn-sm @(currentNaoZeradosFilter == true ? "btn-primary" : "btn-outline-secondary text-white") me-1">Jogos Nunca Zerados</a>

        <a asp-action="ListaJogos" asp-route-filtroPlatinados="@(currentPlatinadosFilter == true ? null : true)" asp-route-termoBusca="@currentFilter" asp-route-filtroAno="@currentYearFilter" asp-route-unicos="@currentUnicos" class="btn btn-sm @(currentPlatinadosFilter == true ? "btn-primary" : "btn-outline-secondary text-white")">Jogos Platinados</a>
    </div>

    @* Tabela *@
    <form asp-action="SalvarOrdemLote" method="post" id="formSalvarOrdem">
        <div class="table-container">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th class="col-id">ID</th>
                        <th class="col-capa">Capa</th>
                        <th class="col-nome">Nome</th>
                        <th class="col-fix">Ano Jogado</th>
                        <th class="col-fix">Zerado Nesse Ano?</th>
                        <th style="width:95px;">Nota</th>
                        <th class="col-fix">Já Zerado?</th>
                        <th class="col-fix">Platinado?</th>
                        <th style="width:70px;">Ordem</th>
                        <th class="col-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><small class="text-muted">@r.Id</small></td>
                            <td class="col-capa">
                                @if (!string.IsNullOrEmpty(r.CoverUrl))
                                {
                                    <img src="@r.CoverUrl" class="img-capa" alt="Capa" />
                                }
                                else
                                {
                                    <div class="img-capa d-flex align-items-center justify-content-center" style="font-size: 10px; color: #555;">N/A</div>
                                }
                            </td>
                            <td class="col-nome fw-semibold" title="@r.Name">@r.Name</td>
                            <td>@r.Year</td>
                            <td>@catalogo_jogos.Helper.MappingHelper.MappingBoolean(@r.FinishedInThisYear)</td>
                            <td>@r.Grade</td>
                            <td>@catalogo_jogos.Helper.MappingHelper.MappingBoolean(@r.EverCompleted)</td>
                            <td>@catalogo_jogos.Helper.MappingHelper.MappingBoolean(@r.Platinado)</td>
                            <td><input type="number" class="form-control form-control-sm text-center" value="@r.Ordem" name="ordemValores[@r.Id]" /></td>
                            <td>
                                <div class="btn-group btn-action-group" role="group">
                                    <a asp-action="TelaEdicao" asp-route-id="@r.Id" class="btn btn-warning btn-sm">Editar</a>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="excluirJogo(event, @r.Id, '@jsEncoder.Encode(r.Name)')">Excluir</button>
                                    <a asp-action="Detalhar" asp-route-id="@r.Id" class="btn btn-info btn-sm text-dark">Detalhes</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function excluirJogo(e, id, n) {
            if (confirm("Excluir '" + n + "'?")) {
                const f = document.createElement('form');
                f.method = 'post'; f.action = '/Jogos/ExcluirJogo/' + id;
                document.body.appendChild(f); f.submit();
            }
        }
    </script>
}